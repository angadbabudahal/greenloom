# ==============================================================================
# GREENLOOM - Environment Variables Template
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit your real .env file or credentials to GitHub.
# - In Vercel, configure these in: Project Settings -> Environment Variables.
# ==============================================================================

# Administrative / Intercom Portal Authentication (Server-Side Only)
ADMIN_ID=Greenloom
ADMIN_INTERCOM_PASSWORD=your_secure_password_here

# GitHub-backed CMS Persistence (Server-Side Only for Serverless Functions)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=angadbabudahal
GITHUB_REPO=greenloom
GITHUB_BRANCH=main
